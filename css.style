/* =========================================
   VARIABLES + RESET
========================================= */
:root{
  --rose:#c9949f; --rose-dark:#7d5560; --rose-light:#e7c7cc;
  --cream:#fbf5ed; --ink:#5e4b50;
  --gold:#b08d57; --gold-light:#e6cd97; --gold-dark:#8a6a3f;
  --foil:linear-gradient(115deg,#8a6a3f,#e6cd97 35%,#b08d57 60%,#f3e3ba 80%,#8a6a3f);
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%;scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--cream);color:var(--ink);font-family:"Cormorant Garamond",Georgia,serif;overflow-x:hidden;line-height:1.5}
button{font-family:inherit}

/* =========================================
   SHARED
========================================= */
.lbl{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:var(--gold-dark);display:inline-flex;align-items:center;gap:8px}
.lbl::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(176,141,87,.22)}
h2{font-weight:300;color:var(--rose-dark);line-height:.85;font-size:clamp(44px,14vw,64px);margin-top:12px}
h2 i{font-weight:300}
small{display:block;font-size:9px;letter-spacing:3px;color:var(--gold-dark)}

.div{display:flex;align-items:center;justify-content:center;gap:12px;margin:18px auto;width:min(240px,65%)}
.div span{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold) 45%,var(--gold) 55%,transparent);opacity:.6}
.div i{width:9px;height:9px;transform:rotate(45deg);background:var(--foil)}

/* =========================================
   HERO
========================================= */
.hero{
  position:relative;overflow:hidden;text-align:center;color:var(--cream);
  padding:64px 20px 36px;min-height:88svh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:
    radial-gradient(ellipse at center,rgba(255,240,215,.22),transparent 55%),
    linear-gradient(140deg,rgba(215,165,176,.9),rgba(189,132,146,.95)),
    url("enhanced-255.jpg") center 22%/cover no-repeat;
}
.hero::before{content:"";position:absolute;inset:14px;border:1px solid rgba(230,205,151,.5);pointer-events:none}
.hero::after{content:"";position:absolute;inset:21px;border:1px solid rgba(255,255,255,.2);pointer-events:none}
.hero>*{position:relative;z-index:1}
.hero .lbl{color:var(--gold-light);font-size:9px}
.hero .lbl::before{display:none}
.hero h1{margin-top:14px;font-weight:400;font-style:italic;font-size:clamp(60px,19vw,92px);line-height:.8;letter-spacing:-2px}
.hero h1 em{display:block;font-family:"Italianno",cursive;font-size:.72em;letter-spacing:0;line-height:1}

.age{width:66px;height:66px;margin:18px auto 12px;border:1px solid var(--gold-light);border-radius:50%;
  box-shadow:0 0 0 4px rgba(230,205,151,.15);display:flex;align-items:center;justify-content:center;
  font-size:19px;letter-spacing:5px;text-indent:5px;color:var(--gold-light)}
.date{font-size:18px;font-weight:600;font-style:italic}
.host{margin-top:4px;font-size:14px;font-weight:600;letter-spacing:.5px;opacity:.9}

.count{display:flex;justify-content:center;gap:8px;margin-top:20px;width:100%}
.cb{flex:1;max-width:76px;padding:12px 0 9px;border:1px solid rgba(230,205,151,.6);background:rgba(255,255,255,.08);backdrop-filter:blur(6px)}
.cb b{display:block;font-size:26px;font-weight:700;color:var(--gold-light);line-height:1.1}
.cb small{margin-top:4px;font-size:8px;font-weight:700;letter-spacing:1.5px;color:var(--cream)}

.scrollcue{margin-top:22px;font-size:9px;font-weight:700;letter-spacing:3px;display:flex;flex-direction:column;align-items:center;gap:6px}
.scrollcue::after{content:"";width:1px;height:28px;background:rgba(255,255,255,.6)}

/* =========================================
   SAVE THE DATE
========================================= */
.details,.venue{position:relative;text-align:center}
.details::before,.venue::before{
  content:"";position:absolute;top:0;left:0;right:0;height:8px;
  background-image:radial-gradient(circle at 10px 4px,var(--gold-light) 2.6px,transparent 3px);
  background-size:24px 8px;opacity:.55}

.details{padding:44px 16px 34px;background:linear-gradient(180deg,var(--rose-light),var(--cream))}

/* date plaque */
.plaque{
  width:min(300px,86%);margin:24px auto 0;padding:18px 16px 16px;
  background:linear-gradient(165deg,#fffaf3,#f6ebe0);
  box-shadow:0 14px 28px rgba(125,85,96,.12),inset 0 0 0 1px rgba(176,141,87,.35);
  position:relative}
.plaque::before{content:"";position:absolute;inset:6px;border:1px solid rgba(176,141,87,.35);pointer-events:none}
.plaque-main{display:flex;flex-direction:column;align-items:center;line-height:1}
.plaque-month{margin-top:8px;font-size:22px;font-style:italic;color:var(--rose-dark)}
.plaque-day{font-size:76px;font-weight:300;line-height:1;margin:4px 0;
  background:var(--foil);-webkit-background-clip:text;background-clip:text;color:transparent}
.plaque-year{font-size:15px;letter-spacing:6px;text-indent:6px;color:var(--gold-dark)}

/* timeline */
.timeline{position:relative;width:min(420px,100%);margin:26px auto 0;padding-left:26px;text-align:left}
.timeline::before{content:"";position:absolute;left:7px;top:14px;bottom:14px;width:1px;
  background:linear-gradient(180deg,var(--gold),var(--gold-light))}
.tl-item{position:relative;margin-bottom:12px}
.tl-item:last-child{margin-bottom:0}
.tl-dot{position:absolute;left:-26px;top:22px;width:15px;height:15px;transform:rotate(45deg);
  background:var(--foil);box-shadow:0 0 0 3px #f5e6e2,0 0 8px rgba(230,205,151,.7)}

.card{display:flex;align-items:flex-start;gap:14px;padding:16px 18px;
  background:linear-gradient(165deg,#fffaf3,#f6ebe0);
  box-shadow:0 10px 22px rgba(125,85,96,.1),inset 0 0 0 1px rgba(176,141,87,.3)}
.ic{font-size:22px;color:var(--gold-dark);width:26px;text-align:center;flex:none;margin-top:14px}
.card h3{margin-top:3px;font-size:21px;font-weight:400;color:var(--rose-dark);line-height:1.15}
.card p{font-size:15px;font-style:italic;line-height:1.25}
.mini{display:inline-block;margin-top:8px;font-size:11px;letter-spacing:2px;text-transform:uppercase;
  text-decoration:none;color:var(--gold-dark);border-bottom:1px solid rgba(176,141,87,.5);padding-bottom:1px}

/* monetary gift note */
.gift{width:min(420px,100%);margin:20px auto 0;padding:14px 18px;display:flex;align-items:center;justify-content:center;gap:12px;
  border:1px dashed rgba(176,141,87,.6);background:rgba(255,250,243,.6)}
.gift-ic{font-size:20px;color:var(--gold-dark)}
.gift p{font-size:17px;font-style:italic;color:var(--rose-dark)}

.foot{max-width:340px;margin:16px auto 0;font-size:14px;line-height:1.55;color:var(--rose-dark);opacity:.85}

/* =========================================
   VENUE
========================================= */
.venue{padding:40px 16px 44px;background:linear-gradient(180deg,var(--cream),#f0e2c4)}
.vcopy{max-width:320px;margin:12px auto 0;font-size:16px;font-style:italic;line-height:1.5}

.tabs{display:flex;justify-content:center;gap:8px;margin:2px auto 14px}
.tab{min-height:44px;padding:10px 26px;font-size:12px;letter-spacing:3px;text-transform:uppercase;cursor:pointer;
  border:1px solid var(--gold);background:transparent;color:var(--gold-dark);-webkit-tap-highlight-color:transparent;
  transition:background .25s,color .25s}
.tab.active{background:var(--rose-dark);border-color:var(--rose-dark);color:var(--cream)}

.frame{position:relative;width:min(460px,100%);margin:0 auto;padding:12px;
  background:linear-gradient(165deg,#fffaf3,#f3e6cf);
  box-shadow:0 18px 34px rgba(125,85,96,.16),inset 0 0 0 1px rgba(176,141,87,.4);border-radius:4px}
.frame::before{content:"";position:absolute;inset:5px;border:1px solid rgba(176,141,87,.45);pointer-events:none;z-index:2}
.map{aspect-ratio:4/3;overflow:hidden;border-radius:2px}
.map iframe{width:100%;height:100%;border:0;display:block;
  filter:sepia(.45) saturate(1.3) hue-rotate(-8deg) contrast(1.05) brightness(1.03)}

.vcard{width:min(460px,100%);margin:16px auto 0;padding:20px 18px;
  background:linear-gradient(165deg,#fffaf3,#f6ebe0);
  box-shadow:0 10px 22px rgba(125,85,96,.1),inset 0 0 0 1px rgba(176,141,87,.3)}
.vcard h3{margin-top:4px;font-size:22px;font-weight:400;color:var(--rose-dark)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:46px;margin-top:14px;padding:12px 24px;
  font-size:12px;letter-spacing:3px;text-decoration:none;color:var(--cream);background:var(--rose-dark);
  box-shadow:0 10px 18px rgba(125,85,96,.28);-webkit-tap-highlight-color:transparent}
.btn span{color:var(--gold-light)}
.btn:active{transform:scale(.97)}

/* =========================================
   REVEAL
========================================= */
.js .rv{opacity:0;transform:translateY(16px);transition:opacity .8s ease,transform .8s ease}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .js .rv{opacity:1;transform:none;transition:none}
}

/* =========================================
   LARGER SCREENS
========================================= */
@media (min-width:700px){
  .hero{min-height:92svh}
  .cb{max-width:90px}
  .cb b{font-size:34px}
}
